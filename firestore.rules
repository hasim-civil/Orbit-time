rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write only their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Each user's own daily attendance records (check-in/check-out).
      match /attendance/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Each user's own personal holiday calendar.
      match /holidays/{holidayId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Each user's own personal leave records — self-tracked, no approval workflow.
      match /leaves/{leaveId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Each user's own notification feed (e.g. late-arrival alerts).
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
